extends ../header
block titleMenu
  title pago
block contenido
  main#Pago.container
    .row
      .col.l7.push-l3
        .card.indigo
          .card-tabs
            ul.tabs.tabs-fixed-width.indigo.tabs-transparent
              li.tab
                a.active(href="#efectivo") efectivo
              li.tab
                a.active(href="#tarjeta") tarjeta
          .card-content.grey.lighten-4
            #efectivo.row
              .card.col.l10.push-l1
                .card-content
                  form.row(action="#", method="post")
                    .input-field.col.l5
                      input#Vivienda.validate(type="text", name="")
                      label(for="Vivienda") Nombre completo
                    .input-field.col.l5
                      input#DireccionDe.validate(type="text", name="")
                      label(for="DireccionDe") Numero de documento
                    .input-field.col.l10
                      input#DireccionDe.validate(type="text", name="")
                      label(for="DireccionDe") Correo Electronico
                      .modal-footer
                .card-action.row
                  .col.l2.left.container
                    a#efecty(href="#", onclick="efecty()")
                      img.efectivo.container(src="/img/icons/efecty.png", alt=" Az click Efecty")
                  .col.l2.push-l6.container
                    a#baloto(href="#", onclick="baloto()")
                      img.efectivo(
                        src="/img/icons/baloto.png",
                        alt="Az Click Via Baloto"
                      )
            #tarjeta.row
              .card.col.l10.push-l1
                .card-content
                  form.row(action="#", method="post")
                    .input-field.col.l6
                      input#Vivienda.validate(type="text", name="")
                      label(for="Vivienda") Numero de tarjeta
                    .input-field.col.l6
                      input#DireccionDe.validate(type="date", name="")
                      label(for="DireccionDe") Fecha de vencimiento
                    .input-field.col.l6
                      input#Pais.validate(type="text", name="")
                      label(for="Pais") Pais
                    .input-field.col.l6
                      input#Ciudad.validate(type="text", name="")
                      label(for="Ciudad") Nombre y apellido
                    .input-field.col.l6
                      input#codigo.validate(type="text", name="")
                      label(for="codigo") Documento
                    .input-field.col.l6
                      input#telefono.validate(type="text", name="")
                      label(for="telefono") Codigo de seguridad (CVV)

                .card-action
                  button#tarjeta.btn.modal-trigger.waves-effect.waves-green.green.accent-4(data-target="Enviar", onclick="tarjeta()") Guardar
                    i.material-icons credit_card
