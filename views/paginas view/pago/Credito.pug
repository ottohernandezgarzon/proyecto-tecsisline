extends Pago

block tarjeta
  .card.col.l10.push-l1
    .card-content
      form.row(action="#", method="post")
        .input-field.col.l6
          input#Vivienda.validate(type="text", name="")
          label(for="Vivienda") Numero de tarjeta
        .input-field.col.l6
          input#DireccionDe.validate(type="date", name="")
          label(for="DireccionDe") Fecha de vencimiento
        .input-field.col.l6
          input#Pais.validate(type="text", name="")
          label(for="Pais") Pais
        .input-field.col.l6
          input#Ciudad.validate(type="text", name="")
          label(for="Ciudad") Nombre y apellido
        .input-field.col.l6
          input#codigo.validate(type="text", name="")
          label(for="codigo") Documento
        .input-field.col.l6
          input#telefono.validate(type="text", name="")
          label(for="telefono") Codigo de seguridad (CVV)
        //- .input-field.col.l12
          input.validate#Recibe(type="Text" name="")
          label(for="Recibe") Nombre de quien recibe
    .card-action
      button.btn.modal-trigger.waves-effect.waves-green.green.accent-4(data-target="Enviar", onclick="mensaje()") guardar
        i.material-icons credit_card
