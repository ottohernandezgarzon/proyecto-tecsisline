extends ../header
block titleMenu
  title Productos
block contenido
  main#contentProductos
    .row
      - for (var x = 0; x < 1; x++)
        .col.s3
          .card.z-depth-3
            .card-img
              img(src="img/photo/bafle.jpg", alt="")
            .card-content
              span.card-title.activator Bafle
              p Bafle azul con amplio sonido y carga rapida
            .card-reveal
              span.card-title.grey-text.text-darken-4 Bafle
              i.material-icons.right cerrar
              p Descripcion del producto.
            .button.card.action
              #Carrito.modal
                .modal-content
                  form.container(action="#", method="post")
                    .input-field.col.s5
                      input#Vivienda.validate(type="text", name="")
                      label(for="Vivienda") Tipo de vivienda
                    .input-field.col.s6
                      input#DireccionDe.validate(type="text", name="")
                      label(for="DireccionDe") Direccion de vivienda
                    .input-field.col.s5
                      input#Pais.validate(type="text", name="")
                      label(for="Pais") Pais
                    .input-field.col.s6
                      input#Ciudad.validate(type="text", name="")
                      label(for="Ciudad") Ciudad
                    .input-field.col.s5
                      input#codigo.validate(type="text", name="")
                      label(for="codigo") Codigo Postal
                    .input-field.col.s6
                      input#telefono.validate(type="text", name="")
                      label(for="telefono") Telefono
                    .input-field.col.s11
                      input#Recibe.validate(type="Text", name="")
                      label(for="Recibe") Nombre de quien recibe
                      .modal-footer
                        a.waves-effect.waves-green.btn.green.accent-4.modal-trigger(href="#Enviar") Enviar
                        #Enviar.modal
                          .modal-content
                            h4.center-align.green-text Gracias por tu compra :)
                        a.modal-close.waves-effect.waves-green.btn.red.accent-4 Cerrar
              a.waves-effect.waves-light.btn.green.accent-4.modal-trigger(href="#Carrito") Comprar Producto
                i.material-icons shopping_cart
